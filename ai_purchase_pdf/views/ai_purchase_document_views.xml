<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_purchase_document_list" model="ir.ui.view">
        <field name="name">ai.purchase.document.list</field>
        <field name="model">ai.purchase.document</field>
        <field name="arch" type="xml">
            <list string="AI Purchase PDFs"
                  decoration-success="state == 'done'"
                  decoration-warning="state in ('review', 'approval_requested', 'approved')"
                  decoration-danger="state == 'error' or state == 'rejected'">
                <field name="name"/>
                <field name="file_name"/>
                <field name="extracted_vendor_name" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="vendor_reference" optional="show"/>
                <field name="purchase_order_id" optional="show"/>
                <field name="approver_id" optional="show"/>
                <field name="overall_confidence" widget="percentage" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ai_purchase_document_search" model="ir.ui.view">
        <field name="name">ai.purchase.document.search</field>
        <field name="model">ai.purchase.document</field>
        <field name="arch" type="xml">
            <search string="Search AI Purchase PDFs">
                <field name="name"/>
                <field name="file_name"/>
                <field name="partner_id"/>
                <field name="extracted_vendor_name"/>
                <field name="vendor_reference"/>
                <field name="approver_id"/>
                <filter string="Needs Review" name="needs_review" domain="[('state', '=', 'review')]"/>
                <filter string="Waiting Approval" name="waiting_approval" domain="[('state', '=', 'approval_requested')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'done')]"/>
                <filter string="Errors" name="errors" domain="[('state', '=', 'error')]"/>
                <separator/>
                <filter string="My Approvals" name="my_approvals" domain="[('approver_id', '=', uid), ('state', '=', 'approval_requested')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Approver" name="group_approver" context="{'group_by': 'approver_id'}"/>
                    <filter string="Vendor" name="group_vendor" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_ai_purchase_document_form" model="ir.ui.view">
        <field name="name">ai.purchase.document.form</field>
        <field name="model">ai.purchase.document</field>
        <field name="arch" type="xml">
            <form string="AI Purchase PDF">
                <header>
                    <button name="action_process_pdf" type="object" string="Process PDF with AI"
                            class="oe_highlight" invisible="state not in ('upload', 'error') or purchase_order_id"/>
                    <button name="action_retry_matching" type="object" string="Retry Matching"
                            invisible="state != 'review' or purchase_order_id"/>
                    <button name="action_create_rfq_and_request" type="object" string="Create Draft RFQ"
                            class="oe_highlight" invisible="state != 'review' or purchase_order_id"/>
                    <button name="action_request_approval" type="object" string="Request Approval"
                            class="oe_highlight" invisible="state not in ('draft_created', 'rejected') or not purchase_order_id"/>
                    <button name="action_approve_and_confirm" type="object" string="Approve &amp; Confirm"
                            class="oe_highlight" invisible="state != 'approval_requested'"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'approval_requested'" confirm="Reject this RFQ and keep it unconfirmed?"/>
                    <button name="action_open_purchase_order" type="object" string="Open RFQ / PO"
                            invisible="not purchase_order_id"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="upload,processing,review,draft_created,approval_requested,approved,done,rejected,error"/>
                </header>

                <sheet>
                    <div class="alert alert-info" role="alert" invisible="state not in ('upload', 'processing')">
                        Upload a supplier purchase-related PDF. AI will extract data, but only existing Odoo vendors and products can be used.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="state != 'review'">
                        Human review is required. Select the correct existing vendor/product wherever matching is uncertain, then create the draft RFQ.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="state != 'approval_requested'">
                        The RFQ is locked from confirmation until the assigned employee or a Purchase Administrator approves it here.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="state != 'error'">
                        <strong>AI processing error:</strong>
                        <field name="error_message" nolabel="1" readonly="1"/>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>

                    <group>
                        <group string="Source &amp; Approval">
                            <field name="file_data" filename="file_name" readonly="state not in ('upload', 'error')"/>
                            <field name="file_name" invisible="1"/>
                            <field name="approver_id" readonly="state in ('approval_requested', 'approved', 'done')"/>
                            <field name="purchase_order_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'upload'"/>
                        </group>
                        <group string="AI Extraction">
                            <field name="extracted_document_type"/>
                            <field name="extracted_vendor_name"/>
                            <field name="vendor_reference"/>
                            <field name="document_date"/>
                            <field name="overall_confidence" widget="percentage"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Vendor &amp; Terms" name="vendor_terms">
                            <group>
                                <group string="Vendor Matching">
                                    <field name="extracted_vendor_name" readonly="1"/>
                                    <field name="extracted_vendor_tax_id" readonly="1"/>
                                    <field name="extracted_vendor_email" readonly="1"/>
                                    <field name="partner_id" readonly="state != 'review'"/>
                                </group>
                                <group string="Purchase Terms">
                                    <field name="extracted_currency_code" readonly="1"/>
                                    <field name="currency_id" readonly="state != 'review'"/>
                                    <field name="extracted_payment_terms" readonly="1"/>
                                    <field name="payment_term_id" readonly="state != 'review'"/>
                                    <field name="delivery_date" readonly="1"/>
                                </group>
                            </group>
                            <group string="Matching Result">
                                <field name="matching_summary" nolabel="1" readonly="1"/>
                            </group>
                            <group string="PDF Notes">
                                <field name="extracted_notes" nolabel="1" readonly="1"/>
                            </group>
                        </page>

                        <page string="Extracted Purchase Lines" name="purchase_lines">
                            <field name="line_ids" readonly="state != 'review'">
                                <list editable="bottom" create="false" delete="false">
                                    <field name="description"/>
                                    <field name="vendor_sku" optional="show"/>
                                    <field name="quantity"/>
                                    <field name="extracted_uom" optional="show"/>
                                    <field name="price_unit"/>
                                    <field name="price_extracted" optional="hide"/>
                                    <field name="tax_rate" optional="show"/>
                                    <field name="confidence" widget="percentage" optional="hide"/>
                                    <field name="product_id"/>
                                    <field name="uom_id"/>
                                    <field name="human_reviewed" optional="show"/>
                                    <field name="match_score" widget="percentage" optional="hide"/>
                                    <field name="match_status" widget="badge"
                                           decoration-success="match_status == 'matched'"
                                           decoration-warning="match_status == 'review'"/>
                                    <field name="match_note" optional="show"/>
                                </list>
                            </field>
                        </page>

                        <page string="Approval Audit" name="approval_audit">
                            <group>
                                <group>
                                    <field name="approval_requested_by_id" readonly="1"/>
                                    <field name="approval_requested_date" readonly="1"/>
                                    <field name="approved_by_id" readonly="1"/>
                                    <field name="approved_date" readonly="1"/>
                                </group>
                                <group>
                                    <field name="rejected_by_id" readonly="1"/>
                                    <field name="rejected_date" readonly="1"/>
                                    <field name="rejection_reason" placeholder="Required before clicking Reject"
                                           readonly="state != 'approval_requested'"/>
                                </group>
                            </group>
                        </page>

                        <page string="Raw AI Data" name="raw_data" groups="base.group_system">
                            <field name="ai_raw_json" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_ai_purchase_document" model="ir.actions.act_window">
        <field name="name">AI Purchase PDFs</field>
        <field name="res_model">ai.purchase.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ai_purchase_document_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Upload a supplier PDF to create an AI-assisted draft RFQ</p>
            <p>AI extracts purchase data, matches existing Odoo master data, and requires human approval before confirmation.</p>
        </field>
    </record>

    <menuitem id="menu_ai_purchase_document"
              name="AI Purchase PDFs"
              parent="purchase.menu_procurement_management"
              action="action_ai_purchase_document"
              sequence="2"
              groups="purchase.group_purchase_user"/>
</odoo>
