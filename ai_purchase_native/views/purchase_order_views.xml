<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_ai_pdf" model="ir.ui.view">
        <field name="name">purchase.order.form.ai.pdf</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@id='bid_confirm']" position="attributes">
                <attribute name="invisible">state != 'sent' or ai_pdf_generated</attribute>
            </xpath>
            <xpath expr="//button[@id='draft_confirm']" position="attributes">
                <attribute name="invisible">state != 'draft' or ai_pdf_generated</attribute>
            </xpath>

            <xpath expr="//form/header" position="inside">
                <button name="action_ai_approve_confirm"
                        string="Approve &amp; Confirm"
                        type="object"
                        class="oe_highlight"
                        groups="purchase.group_purchase_user"
                        invisible="not ai_pdf_generated or ai_approval_state != 'pending' or state not in ['draft', 'sent']"/>
                <button name="action_ai_reject"
                        string="Reject AI Draft"
                        type="object"
                        groups="purchase.group_purchase_user"
                        invisible="not ai_pdf_generated or ai_approval_state != 'pending' or state not in ['draft', 'sent']"/>
                <button name="action_ai_request_approval"
                        string="Request Approval Again"
                        type="object"
                        groups="purchase.group_purchase_user"
                        invisible="not ai_pdf_generated or ai_approval_state != 'rejected' or state not in ['draft', 'sent']"/>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="ai_pdf_generated" invisible="1"/>
                <field name="ai_approval_state" widget="badge" invisible="not ai_pdf_generated"/>
                <field name="ai_approver_id" invisible="not ai_pdf_generated"/>
                <field name="ai_approved_by_id" invisible="not ai_pdf_generated or not ai_approved_by_id" readonly="1"/>
                <field name="ai_approved_date" invisible="not ai_pdf_generated or not ai_approved_date" readonly="1"/>
                <field name="ai_unmatched_line_count" invisible="not ai_pdf_generated" readonly="1"/>
                <field name="ai_vendor_needs_review" invisible="1"/>
                <field name="ai_source_filename" invisible="1"/>
                <field name="ai_source_attachment_id" invisible="1"/>
            </xpath>

            <xpath expr="//sheet" position="before">
                <div class="alert alert-info mb-2" role="alert" invisible="not ai_pdf_generated">
                    <strong>AI-generated RFQ.</strong>
                    Review the source PDF, vendor, products, quantities, prices and taxes before using <strong>Approve &amp; Confirm</strong>.
                </div>
                <div class="alert alert-warning mb-2" role="alert"
                     invisible="not ai_pdf_generated or (ai_unmatched_line_count == 0 and not ai_vendor_needs_review)">
                    Human correction is required before approval:
                    <span invisible="not ai_vendor_needs_review">select the correct vendor.</span>
                    <span invisible="ai_unmatched_line_count == 0">replace all “AI Product Match Required” product lines.</span>
                </div>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_ai_source_pdf"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-pdf-o"
                        invisible="not ai_pdf_generated or not ai_source_attachment_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Source PDF</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
