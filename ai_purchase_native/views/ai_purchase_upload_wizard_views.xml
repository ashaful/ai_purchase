<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_purchase_upload_wizard_form" model="ir.ui.view">
        <field name="name">ai.purchase.upload.wizard.form</field>
        <field name="model">ai.purchase.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Purchase PDF">
                <div class="alert alert-info" role="alert">
                    Upload a supplier quotation, purchase requirement, requisition, pro-forma, or purchase-order-like PDF.
                    Odoo's configured Google Gemini provider will read it and create a draft RFQ for human review.
                </div>
                <group>
                    <field name="file_data" filename="file_name" widget="binary"/>
                    <field name="file_name" invisible="1"/>
                    <field name="approver_id" options="{'no_create': True, 'no_open': True}"/>
                </group>
                <footer>
                    <button name="action_create_draft_rfq" string="Create Draft RFQ with Odoo AI" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ai_purchase_upload_wizard" model="ir.actions.act_window">
        <field name="name">Upload Purchase PDF</field>
        <field name="res_model">ai.purchase.upload.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_ai_purchase_upload_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_ai_purchase_upload"
              name="Upload Purchase PDF"
              parent="purchase.menu_procurement_management"
              action="action_ai_purchase_upload_wizard"
              sequence="2"
              groups="purchase.group_purchase_user"/>
</odoo>
